# Base RPC URL (you can use a public RPC or get one from services like Alchemy, Infura, or QuickNode)
BASE_RPC_URL=https://mainnet.base.org

# Optional: Starting block number to fetch from (defaults to 0)
# Set this to the block when the staking contract was deployed to skip empty blocks
# START_BLOCK=10000000

# Optional: Ending block number to fetch to (defaults to current block)
# Set this to scan only up to a specific block (useful for historical analysis or testing)
# END_BLOCK=15000000
